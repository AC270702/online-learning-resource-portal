@model OnlineLearningResourcePortal.Models.Course
@{
    ViewData["Title"] = "Delete course";
}

<h1>Delete course</h1>
<p class="alert alert-warning">Are you sure you want to delete this course? Favorites pointing to it will be removed.</p>

<dl class="row">
    <dt class="col-sm-2">Title</dt>
    <dd class="col-sm-10">@Model.Title</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
</form>
