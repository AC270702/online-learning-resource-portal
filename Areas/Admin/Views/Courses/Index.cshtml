@model IEnumerable<OnlineLearningResourcePortal.Models.Course>
@{
    ViewData["Title"] = "Admin – Courses";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Manage courses</h1>
    <a class="btn btn-primary" asp-action="Create">Add course</a>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Title</th>
            <th>Created</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var c in Model)
    {
        <tr>
            <td>@c.Title</td>
            <td>@c.CreatedAt.ToLocalTime().ToString("g")</td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@c.Id">Edit</a>
                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@c.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
