@model OnlineLearningResourcePortal.Models.Course
@{
    ViewData["Title"] = Model.Title;
}

@if (TempData["Flash"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Flash"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<h1>@Model.Title</h1>
<p class="lead">@Model.Description</p>

@if (!string.IsNullOrWhiteSpace(Model.ThumbnailUrl))
{
    <p><img src="@Model.ThumbnailUrl" class="img-fluid rounded" alt="" /></p>
}

@if (!string.IsNullOrWhiteSpace(Model.ResourceUrl))
{
    <p>
        <a class="btn btn-outline-primary" href="@Model.ResourceUrl" target="_blank" rel="noopener">Open resource</a>
    </p>
}

@if (User.Identity?.IsAuthenticated == true)
{
    <form asp-controller="Favorites" asp-action="Toggle" asp-route-id="@Model.Id" method="post" class="mt-3">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-secondary">Save / remove favorite</button>
    </form>
}
else
{
    <p class="text-muted mt-3"><a asp-area="Identity" asp-page="/Account/Login">Log in</a> to save this course to your favorites.</p>
}

<p class="mt-4"><a asp-action="Index">← Back to courses</a></p>
