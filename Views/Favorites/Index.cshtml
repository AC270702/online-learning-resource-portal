@model IEnumerable<OnlineLearningResourcePortal.Models.Favorite>
@{
    ViewData["Title"] = "My favorites";
}

<h1>My favorites</h1>

@if (!Model.Any())
{
    <p>You have not saved any courses yet. Browse the <a asp-controller="Courses" asp-action="Index">course list</a>.</p>
}
else
{
    <ul class="list-group">
        @foreach (var f in Model)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <a asp-controller="Courses" asp-action="Details" asp-route-id="@f.CourseId">@f.Course.Title</a>
                <form asp-controller="Favorites" asp-action="Toggle" asp-route-id="@f.CourseId" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                </form>
            </li>
        }
    </ul>
}
